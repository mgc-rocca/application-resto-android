<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Resto" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
    <style name="Theme.Resto.Places" parent="PlacesMaterialTheme">
        <item name="placesColorPrimary">#31473A</item>
        <item name="placesColorOnSurface">#202522</item>
        <item name="placesColorOnSurfaceVariant">#6B716D</item>
        <item name="placesColorSurface">#FFFFFF</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
